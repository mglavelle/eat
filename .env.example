# Copy to .env and fill in. Everything here is optional.

# Where the database lives.
DATA_DIR=./data

# Restaurant search.
#   Blank  -> OpenStreetMap (free, no account; no ratings or prices).
#   Filled -> Google Places (ratings, prices, "open now"). Needs a Google Cloud project with
#             "Places API (New)" enabled and billing set up. A refresh makes ~25 requests and the
#             results are cached, so normal use stays inside Google's free monthly allowance.
GOOGLE_PLACES_API_KEY=

# "Ask" page: local model through Ollama (same setup as the D&D Companion).
# OLLAMA_URL can stay blank: the app reuses Ollama's own OLLAMA_HOST setting.
OLLAMA_URL=
CHAT_MODEL=qwen3.5:latest
CHAT_CTX=6144

# Keeps you signed in across restarts. Blank = one is generated and saved in the data folder.
SESSION_SECRET=
